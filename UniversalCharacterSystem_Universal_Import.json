    "id": "universal-reply-v2",
    "scriptName": "通用世界观 · 回复面板",
    "findRegex": "<world-reply>([\\s\\S]*?)<\\/world-reply>",
    "replaceString": "<div style=\"font-family:system-ui,sans-serif;max-width:760px;margin:10px auto;padding:16px;border:1px solid #e7a8c2;border-radius:18px;background:#fffafd;color:#553746;box-shadow:0 8px 22px #d9789d2b\"><div style=\"display:flex;justify-content:space-between;gap:10px;align-items:start\"><div><h3 id=\"wr-title\" style=\"margin:0;color:#a94772\">回复</h3><div style=\"font-size:12px;color:#8d6b81;margin-top:5px\"><span id=\"wr-mood\"></span> · <span id=\"wr-status\"></span></div></div><span style=\"font-size:20px\">✦</span></div><div id=\"wr-quote\" style=\"margin-top:12px;padding:11px 13px;border-radius:12px;background:#fff0f5;line-height:1.7\"></div><div style=\"margin-top:12px;font-size:14px;line-height:1.8;white-space:pre-wrap\" id=\"wr-summary\"></div><details style=\"margin-top:10px\"><summary style=\"cursor:pointer;color:#a94772\">补充信息</summary><div id=\"wr-details\" style=\"padding-top:8px;white-space:pre-wrap;line-height:1.7\"></div></details><div id=\"wr-actions\" style=\"display:flex;flex-wrap:wrap;gap:7px;margin-top:12px\"></div></div><script>(function(){var s=String.raw`$1`,d={};s.split(/\\r?\\n/).forEach(function(x){var i=x.indexOf(':');if(i>0)d[x.slice(0,i).trim().toLowerCase()]=x.slice(i+1).trim()});document.getElementById('wr-title').textContent=d.title||'角色回复';document.getElementById('wr-mood').textContent='心情：'+(d.mood||'平静');document.getElementById('wr-status').textContent='状态：'+(d.status||'正常');document.getElementById('wr-quote').textContent=d.quote||'';document.getElementById('wr-summary').textContent=d.summary||'';document.getElementById('wr-details').textContent=d.details||'无';(d.actions||'继续对话|查看状态').split('|').filter(Boolean).forEach(function(x){var b=document.createElement('span');b.textContent=x.trim();b.style.cssText='padding:7px 10px;border:1px solid #e7a8c2;border-radius:999px;color:#a94772;font-size:12px';document.getElementById('wr-actions').appendChild(b)});})();</script>",
