  {
    "id": "universal-opening-v2",
    "scriptName": "通用世界观 · 开场面板",
    "findRegex": "<world-opening>([\\s\\S]*?)<\\/world-opening>",
    "replaceString": "<div style=\"font-family:system-ui,sans-serif;max-width:760px;margin:10px auto;padding:18px;border:1px solid #e7a8c2;border-radius:18px;background:linear-gradient(135deg,#fff8fb,#fff);color:#553746;box-shadow:0 10px 28px #d9789d33\"><div style=\"display:flex;gap:12px;align-items:center;margin-bottom:12px\"><div style=\"width:46px;height:46px;border-radius:14px;display:grid;place-items:center;background:#ef78a5;color:white;font-size:24px\">✦</div><div><div style=\"font-size:11px;color:#9a7284;letter-spacing:.08em\">UNIVERSAL WORLD SYSTEM</div><h2 id=\"uw-title\" style=\"margin:3px 0 0;font-size:21px\">角色</h2><div id=\"uw-subtitle\" style=\"font-size:12px;color:#8d6b81\"></div></div></div><div style=\"display:flex;flex-wrap:wrap;gap:7px;margin-bottom:12px\"><span id=\"uw-status\" style=\"padding:6px 10px;border-radius:999px;background:#fff0f5;color:#c94d7b;font-size:12px\"></span><span id=\"uw-relation\" style=\"padding:6px 10px;border-radius:999px;background:#f2f6ff;color:#5574a8;font-size:12px\"></span></div><blockquote id=\"uw-quote\" style=\"margin:0 0 12px;padding:12px 14px;border-left:3px solid #ef78a5;background:#fffafc;line-height:1.8\"></blockquote><div id=\"uw-body\" style=\"white-space:pre-wrap;line-height:1.75;font-size:14px\"></div></div><script>(function(){var t=document.createElement('template');t.innerHTML=`$1`;var s=(t.content.textContent||'').trim(),d={};s.split(/\\r?\\n/).forEach(function(x){var i=x.indexOf(':');if(i>0)d[x.slice(0,i).trim().toLowerCase()]=x.slice(i+1).trim()});document.getElementById('uw-title').textContent=d.title||'未命名角色';document.getElementById('uw-subtitle').textContent=d.subtitle||'';document.getElementById('uw-status').textContent='状态：'+(d.status||'待机');document.getElementById('uw-relation').textContent='关系：'+(d.relationship||'未知');document.getElementById('uw-quote').textContent=d.quote||'……';document.getElementById('uw-body').textContent=d.scene||d.description||'等待世界状态。';})();</script>",
