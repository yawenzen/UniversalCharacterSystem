  {
    "id": "universal-status-v2",
    "scriptName": "通用世界观 · 完整状态面板",
    "findRegex": "<world-status>([\\s\\S]*?)<\\/world-status>",
    "replaceString": "<div style=\"font-family:system-ui,sans-serif;max-width:760px;margin:10px auto;padding:16px;border:1px solid #e7a8c2;border-radius:18px;background:#fff;color:#553746\"><h3 style=\"margin:0 0 12px;color:#a94772\" id=\"ws-title\">世界状态</h3><div id=\"ws-stats\" style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:8px\"></div><div style=\"margin-top:14px\"><b style=\"color:#a94772\">状态</b><div id=\"ws-status\" style=\"white-space:pre-wrap;line-height:1.7;margin-top:5px\"></div></div><div style=\"margin-top:14px\"><b style=\"color:#a94772\">开发度 / 敏感区</b><div id=\"ws-body\" style=\"white-space:pre-wrap;line-height:1.7;margin-top:5px\"></div></div><div style=\"margin-top:14px\"><b style=\"color:#a94772\">系统</b><div id=\"ws-system\" style=\"white-space:pre-wrap;line-height:1.7;margin-top:5px\"></div></div></div><script>(function(){var s=String.raw`$1`,d={};s.split(/\\r?\\n/).forEach(function(x){var i=x.indexOf(':');if(i>0)d[x.slice(0,i).trim().toLowerCase()]=x.slice(i+1).trim()});document.getElementById('ws-title').textContent=d.title||'世界状态';var keys=[['好感度','affection'],['信任度','trust'],['服从度','obedience'],['情绪值','emotion'],['欲望值','desire'],['纯洁度','purity'],['堕落度','depravity']];keys.forEach(function(k){var e=document.createElement('div');e.style.cssText='padding:9px;border:1px solid #f0d2df;border-radius:10px;background:#fffafd;font-size:13px';e.innerHTML='<span style=\"color:#8d6b81\">'+k[0]+'</span><br><b style=\"color:#e15e91\">'+(d[k[1]]||'—')+'</b>';document.getElementById('ws-stats').appendChild(e)});document.getElementById('ws-status').textContent=d.status||'无活动状态';document.getElementById('ws-body').textContent=(d.development_detail||'暂无开发度详情')+'\\n'+(d.sensitive_detail||'暂无敏感区详情');document.getElementById('ws-system').textContent=[d.hypnosis_status?'催眠：'+d.hypnosis_status:'',d.gacha_status?'抽卡：'+d.gacha_status:'',d.event?'事件：'+d.event:'',d.npc?'NPC：'+d.npc:'',d.special_day?'日期：'+d.special_day:''].filter(Boolean).join('\\n')||'无特殊系统状态';})();</script>",
